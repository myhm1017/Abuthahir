<?xml version="1.0" encoding="utf-8"?>
<!-- One place in the small widget: a gentle loop of frames that blend into each other. -->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/place_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:flipInterval="350"
    android:inAnimation="@anim/frame_in"
    android:outAnimation="@anim/frame_out" />
